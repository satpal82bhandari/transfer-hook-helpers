const fs = require('fs');
const bs58 = require('bs58');

// Path to the Solana config file
const pathToConfig = '/home/satpal/.config/solana/id_user2.json';

// Read the JSON file
const privateKeyBytes = JSON.parse(fs.readFileSync(pathToConfig, 'utf8'));

// Convert the byte array to a base58 string
const base58PrivateKey = bs58.encode(Buffer.from(privateKeyBytes));

console.log('Base58 Encoded Private Key:', base58PrivateKey);